{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".agents/skills"]
  },
  "instructions": ["_docs/permissions.md"],
  "permission": {
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git commit --amend*": "deny",
      "git rebase*": "deny",
      "rm -rf*": "deny"
    }
  },
  "mcp": {
    "agrivanta-backlog": {
      "type": "local",
      "command": ["uv", "run", "mcp-server/server.py"],
      "enabled": true,
      "timeout": 15000
    }
  }
}
