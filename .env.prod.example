# Production-like stack environment template (docker-compose.prod.yml).
#
# Copy to .env.prod, replace every placeholder, and run:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# This stack is for exercising production behaviour locally. It is not a
# deployment pipeline, and the values below must never be committed with real
# secrets.

# --- Image identity ---
# Use an explicit release version or commit SHA, for example:
#   AGRIVANTA_VERSION=$(git rev-parse --short HEAD)
AGRIVANTA_VERSION=local
AGRIVANTA_REVISION=unknown

# --- Django backend ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=agrivanta
POSTGRES_USER=agrivanta
POSTGRES_PASSWORD=replace-with-a-strong-password

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Optional backend integrations ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SENTRY_DSN=

# --- Frontend build baked into the backend image ---
VITE_API_CLIENT=http
VITE_API_BASE_URL=/api
VITE_SENTRY_DSN=

# --- Gunicorn and host port mapping ---
GUNICORN_WORKERS=3
AGRIVANTA_WEB_PORT=8000
