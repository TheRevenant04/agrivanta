# Which services implementation the app uses.
# "mock" (default) runs entirely in the browser with seed data and needs no
# backend. "http" uses the real backend over fetch.
VITE_API_CLIENT=mock

# Base URL for the HTTP implementation. Required when VITE_API_CLIENT=http.
# Example: VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000/api

# Optional Sentry project DSN for frontend error reporting.
VITE_SENTRY_DSN=
