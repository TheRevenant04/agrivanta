# Development stack environment template (docker-compose.yml).
#
# Copy to .env.dev and run:
#   docker compose --env-file .env.dev up --build
#
# The defaults in docker-compose.yml already work for local development, so
# these values are safe placeholders for local use only. Never reuse them for
# a real deployment.

# --- Django backend ---
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- PostgreSQL ---
POSTGRES_DB=agrivanta
POSTGRES_USER=agrivanta
POSTGRES_PASSWORD=agrivanta

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Optional backend integrations ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SENTRY_DSN=

# --- Vite frontend dev server ---
VITE_API_CLIENT=http
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SENTRY_DSN=

# --- Host port mappings ---
AGRIVANTA_WEB_PORT=8000
AGRIVANTA_FRONTEND_PORT=5173
